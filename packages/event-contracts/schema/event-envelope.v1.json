{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiciv.local/contracts/event-envelope.v1.json",
  "title": "AI Civilization event envelope v1",
  "description": "Every event the backend publishes, whether over the realtime stream or from the reconciliation endpoint, uses this envelope. PostgreSQL is the source of truth; this envelope is a projection of a row in the events table. V4.0 added management, research, logistics and release event types ; V5.0 added finance.* types for the AI Central Bank, whose payloads carry ids, statuses and labels only, never amounts or account data (additive; schema_version stays 1 because no existing field changed meaning).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "organization_id",
    "mission_id",
    "agent_id",
    "event_type",
    "sequence",
    "occurred_at",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": 1
    },
    "organization_id": {
      "type": "string",
      "format": "uuid"
    },
    "mission_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "agent_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "event_type": {
      "enum": [
        "mission.created",
        "mission.started",
        "mission.status_changed",
        "mission.completed",
        "mission.failed",
        "mission.cancelled",
        "task.assigned",
        "task.started",
        "task.progress",
        "task.completed",
        "task.failed",
        "agent.message",
        "agent.status_changed",
        "agent.movement_requested",
        "agent.arrived",
        "tool.started",
        "tool.completed",
        "tool.failed",
        "approval.requested",
        "approval.granted",
        "approval.rejected",
        "artifact.created",
        "usage.recorded",
        "system.emergency_stop",
        "manager.goal_assigned",
        "manager.review_started",
        "manager.review_completed",
        "manager.revision_requested",
        "manager.escalation_created",
        "charter.amended",
        "recovery.proposed",
        "recovery.decided",
        "manager.loop_detected",
        "mission.objective_checked",
        "agent.lesson_learned",
        "agent.lessons_recalled",
        "manager.decision_recorded",
        "research.started",
        "research.finding_created",
        "research.opportunity_identified",
        "research.completed",
        "package.dispatched",
        "package.in_transit",
        "package.arrived",
        "package.rerouted",
        "package.delivery_failed",
        "package.received",
        "release.manager_approved",
        "release.owner_approval_requested",
        "release.owner_approved",
        "release.owner_rejected",
        "release.authorized",
        "release.invalidated",
        "release.executed",
        "opportunity.status_changed",
        "report.submitted",
        "logistics.route_status_changed",
        "finance.packet_created",
        "finance.packet_status_changed",
        "finance.fee_detected",
        "finance.research_requested",
        "finance.findings_returned",
        "finance.recommendation_ready",
        "finance.gm_reviewed",
        "finance.approval_requested",
        "finance.approval_decided",
        "finance.approval_expired",
        "finance.action_executed",
        "finance.action_refused",
        "finance.connection_status_changed",
        "finance.sync_completed",
        "finance.sync_failed",
        "finance.bill_reminder",
        "finance.tax_estimate_updated",
        "finance.forecast_updated",
        "finance.revenue_reported",
        "finance.investigation_status_changed",
        "finance.investigation_ready",
        "lab.repository_changed",
        "lab.cycle_status_changed",
        "lab.proposals_ready",
        "lab.proposal_decided",
        "lab.change_published",
        "lab.change_status",
        "game.score_recorded",
        "game.season_changed",
        "factory.synced",
        "usage.budget_updated",
        "knowledge.consulted",
        "knowledge.updated"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object"
    },
    "execution_mode": {
      "description": "live = real tool execution / real model call. simulation = clearly labeled stand-in (no provider credentials, or ambient world motion).",
      "enum": [
        "live",
        "simulation"
      ]
    }
  }
}
