# ---------------------------------------------------------------------------
# AI Civilization — copy to .env and fill in what you have. Nothing here is required
# for local simulation mode; every missing credential has a documented fallback.
# ---------------------------------------------------------------------------

# Model providers. With neither key set, missions run in clearly labeled SIMULATION mode:
# tools and tests still execute for real, but text and the patch come from a fixture.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AICIV_ANTHROPIC_MODEL=claude-sonnet-5-5
AICIV_OPENAI_MODEL=gpt-4.1-mini
# Price table for cost ESTIMATES (USD per million tokens). Never shown as a confirmed charge.
# AICIV_PRICE_ANTHROPIC_IN=3
# AICIV_PRICE_ANTHROPIC_OUT=15

# Auth. Leave both empty for local dev (localhost only). Set a long random token to use the
# app from your phone or anywhere else; paste the same token into System > Server in the app.
AICIV_API_TOKEN=
# Or verify Supabase Auth access tokens instead:
SUPABASE_JWT_SECRET=

# Database. Empty = SQLite file in .data/. Production: Supabase Postgres with
# infrastructure/migrations/0001_init.sql applied (needs psycopg: pip install "psycopg[binary]").
DATABASE_URL=
AICIV_DATA_DIR=

# Supabase Realtime Broadcast (optional; the app works on its own SSE stream without it)
SUPABASE_URL=
# Publishable (browser-safe) key; the iPhone app reads it from /api/public-config
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Budgets and limits
AICIV_MISSION_BUDGET_USD=1.0
AICIV_DAILY_BUDGET_USD=5.0
AICIV_COST_WARNING_RATIO=0.8
AICIV_MAX_CONCURRENT_MISSIONS=2
AICIV_TOOL_TIMEOUT_SECONDS=60

# Sandbox: "process" (default; rlimits + no-network namespace when available) or "docker"
AICIV_SANDBOX=process

# Browser origins allowed to call the API
AICIV_ALLOWED_ORIGINS=http://localhost:3000
# Cosmetic walking time between districts (seconds)
AICIV_TRAVEL_SECONDS=1.5

# Web app: where the browser finds the API
NEXT_PUBLIC_API_URL=http://localhost:8000

# GitHub App (optional, for real pull requests on connected repos)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=

# ---------------------------------------------------------------- V4.0 management, research, logistics
# Per-agent model override (defaults: General Manager claude-opus-5-5, researchers claude-haiku-5-5, others claude-sonnet-5-5)
# AICIV_MODEL_GENERAL_MANAGER=claude-opus-5-5
# AICIV_MODEL_RESEARCH_APPS=claude-haiku-5-5
# Price placeholders per model family for cost ESTIMATES (USD per million tokens)
# AICIV_PRICE_OPUS_IN=15
# AICIV_PRICE_OPUS_OUT=75
# AICIV_PRICE_HAIKU_IN=1
# AICIV_PRICE_HAIKU_OUT=5

# Research: auto = live when permitted access exists, else labeled fixtures; live = never fixtures; fixture = always fixtures
AICIV_RESEARCH_MODE=auto
ETSY_API_KEY=
DEPOP_PARTNER_API_URL=
DEPOP_PARTNER_TOKEN=
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=
ASC_VENDOR_NUMBER=

# Opportunity scoring weights (JSON, per component) and owner priorities (comma separated)
# AICIV_SCORE_WEIGHTS={"demand": 2, "momentum": 1.5}
AICIV_OWNER_PRIORITIES=productivity,fitness,skateboarding

# General Manager delegation: routing threshold and the spend it may commit without the owner
AICIV_GM_ROUTE_THRESHOLD=0.55
AICIV_GM_DELEGATED_LIMIT_USD=5

# Conveyor belt speed (world units per second) and scheduler tick scaling
AICIV_BELT_SPEED=8
AICIV_TICK_SCALE=1

# ---------------------------------------------------------------- V5: AI Central Bank (see docs/finance/THREAT_MODEL.md)
# Fernet key that encrypts financial connection credentials and TOTP secrets. REQUIRED outside dev mode.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AICIV_FINANCE_KEY=
# Costs at or above this yearly amount (USD) are "significant" and go to the General Manager before the owner.
AICIV_FINANCE_SIGNIFICANT_USD=100
# Detected fees below this yearly amount (USD) are recorded but don't open a cost review.
AICIV_FINANCE_FEE_REVIEW_MIN_USD=20
# How long a financial approval request stays valid, in hours.
AICIV_FINANCE_APPROVAL_TTL_HOURS=72
# Bills due within this many days produce a reminder (and a payment proposal unless on autopay).
AICIV_FINANCE_BILL_REMINDER_DAYS=7
# Tax planning: jurisdictions to track and the reserve rate (an assumption, not a tax computation).
AICIV_FINANCE_JURISDICTIONS=US-FED
AICIV_TAX_RESERVE_RATE=0.30
# Financial connections (Stripe, Plaid, App Store Connect) are never read from the environment: the owner
# authorizes each one in the app, with step-up, and the credential is stored encrypted.
